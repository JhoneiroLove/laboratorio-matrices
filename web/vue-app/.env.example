# Dejá el valor vacío para usar solicitudes /api del mismo origen (recomendado con nginx y el proxy de Vite).
VITE_MATRIX_API_URL=

# Destino del proxy de desarrollo que usa `npm run dev`.
VITE_MATRIX_API_PROXY=http://localhost:8080

# Tiempo límite de las solicitudes del navegador a la API, en milisegundos (predeterminado: 15000).
VITE_API_TIMEOUT_MS=15000
