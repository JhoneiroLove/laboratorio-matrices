PORT=3000
JSON_BODY_LIMIT=256kb
CORS_ORIGINS=https://app.example.com
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=https://identity.example.com
JWT_AUDIENCE=statistics-api
JWT_CLOCK_TOLERANCE_SECONDS=30
MATRIX_EPSILON=1e-10
MAX_MATRICES=100
MAX_MATRIX_ROWS=1000
MAX_MATRIX_COLUMNS=1000
MAX_TOTAL_ELEMENTS=1000000
SHUTDOWN_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
LOG_LEVEL=info
