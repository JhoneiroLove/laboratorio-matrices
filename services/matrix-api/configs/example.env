MATRIX_API_ADDR=:8080
MATRIX_MAX_ROWS=256
MATRIX_MAX_COLUMNS=256
MATRIX_MAX_ELEMENTS=65536
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1m
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=matrix-api
JWT_AUDIENCE=matrix-api
JWT_TTL=15m
JWT_LEEWAY=30s
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me
ANALYTICS_BASE_URL=http://analytics-api:3000
ANALYTICS_TIMEOUT=5s
